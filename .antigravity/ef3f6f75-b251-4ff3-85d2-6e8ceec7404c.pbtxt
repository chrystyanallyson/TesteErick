    instruction: "Update Logo component SVG to match the exact Eric Moura embroidered seal from the image"
    replacement_infos {
      original_chunk {
        target_content: "  return (\n    <div className=\"relative group flex justify-center items-center\">\n      {/* SVG recreating the Eric Moura Green Seal Logo */}\n      <svg\n        viewBox=\"0 0 200 200\"\n        className=\"w-28 h-28 print:w-28 print:h-28 drop-shadow-sm select-none\"\n      >\n        {/* Outer dotted/textured ring */}\n        <circle cx=\"100\" cy=\"100\" r=\"96\" fill=\"#1b4d2e\" />\n        <circle cx=\"100\" cy=\"100\" r=\"91\" fill=\"none\" stroke=\"#2d6a4f\" strokeWidth=\"2\" strokeDasharray=\"4,3\" />\n        \n        {/* Middle Ring */}\n        <circle cx=\"100\" cy=\"100\" r=\"85\" fill=\"#2d6a4f\" />\n        <circle cx=\"100\" cy=\"100\" r=\"80\" fill=\"#f4f9f4\" stroke=\"#1b4d2e\" strokeWidth=\"3\" />\n\n        {/* Leaf details top and side */}\n        <path d=\"M 60,65 Q 80,45 100,55 Q 80,75 60,65 Z\" fill=\"#2d6a4f\" opacity=\"0.4\" />\n        <path d=\"M 140,65 Q 120,45 100,55 Q 120,75 140,65 Z\" fill=\"#2d6a4f\" opacity=\"0.4\" />\n\n        {/* Vegetables/Leaves subtle background watermark */}\n        <circle cx=\"70\" cy=\"140\" r=\"8\" fill=\"#1b4d2e\" opacity=\"0.2\" />\n        <circle cx=\"130\" cy=\"140\" r=\"8\" fill=\"#1b4d2e\" opacity=\"0.2\" />\n        <circle cx=\"100\" cy=\"148\" r=\"10\" fill=\"#2d6a4f\" opacity=\"0.2\" />\n\n        {/* Center Banner / Text Container */}\n        <rect x=\"35\" y=\"70\" width=\"130\" height=\"60\" rx=\"6\" fill=\"#386641\" />\n        <rect x=\"38\" y=\"73\" width=\"124\" height=\"54\" rx=\"4\" fill=\"none\" stroke=\"#e9f5ec\" strokeWidth=\"1.5\" />\n\n        {/* Brand Text */}\n        <text\n          x=\"100\"\n          y=\"98\"\n          textAnchor=\"middle\"\n          fill=\"#ffffff\"\n          fontSize=\"24\"\n          fontWeight=\"900\"\n          fontFamily=\"Impact, Arial Black, sans-serif\"\n          letterSpacing=\"2\"\n        >\n          ERIC\n        </text>\n        <text\n          x=\"100\"\n          y=\"118\"\n          textAnchor=\"middle\"\n          fill=\"#d8f3dc\"\n          fontSize=\"13\"\n          fontWeight=\"700\"\n          fontFamily=\"Arial, sans-serif\"\n          letterSpacing=\"3\"\n        >\n          MOURA\n        </text>\n      </svg>\n\n      {isEditing && (\n        <label className=\"absolute inset-0 bg-black/60 text-white rounded-full opacity-0 group-hover:opacity-100 flex flex-col items-center justify-center cursor-pointer text-xs font-semibold print:hidden transition-opacity p-2 text-center\">\n          <span>Carregar Imagem</span>\n          <input type=\"file\" accept=\"image/*\" onChange={handleFileChange} className=\"hidden\" />\n        </label>\n      )}\n    </div>\n  );"
        replacement_content: "  return (\n    <div className=\"relative group flex justify-center items-center\">\n      {/* SVG recreating the exact Eric Moura Green Embroidered Seal Logo */}\n      <svg\n        viewBox=\"0 0 200 200\"\n        className=\"w-28 h-28 print:w-28 print:h-28 drop-shadow-md select-none\"\n      >\n        <defs>\n          {/* Subtle fabric texture for inner circle */}\n          <pattern id=\"fabricPattern\" width=\"6\" height=\"6\" patternUnits=\"userSpaceOnUse\">\n            <path d=\"M0 3 L6 3 M3 0 L3 6\" stroke=\"#e2e8f0\" strokeWidth=\"0.8\" />\n          </pattern>\n          {/* Outer Ring Gradient */}\n          <radialGradient id=\"ringGrad\" cx=\"50%\" cy=\"50%\" r=\"50%\">\n            <stop offset=\"70%\" stopColor=\"#22532d\" />\n            <stop offset=\"100%\" stopColor=\"#15381e\" />\n          </radialGradient>\n        </defs>\n\n        {/* Outer Shadow/Border */}\n        <circle cx=\"100\" cy=\"100\" r=\"98\" fill=\"#14331b\" />\n\n        {/* Outer Green Ring */}\n        <circle cx=\"100\" cy=\"100\" r=\"95\" fill=\"url(#ringGrad)\" stroke=\"#c29b38\" strokeWidth=\"2.5\" strokeDasharray=\"6,2\" />\n\n        {/* Produce Icons around the green ring (golden outline icons) */}\n        {/* Pineapple top right */}\n        <g stroke=\"#d4af37\" strokeWidth=\"1.2\" fill=\"none\" opacity=\"0.85\">\n          {/* Pineapple */}\n          <path d=\"M 148,45 C 150,40 155,42 153,48 C 150,52 145,50 148,45 Z\" />\n          <ellipse cx=\"150\" cy=\"53\" rx=\"5\" ry=\"6\" />\n          \n          {/* Tomato bottom */}\n          <circle cx=\"100\" cy=\"180\" r=\"6\" />\n          <path d=\"M 97,174 Q 100,172 103,174\" />\n\n          {/* Grapes top left */}\n          <circle cx=\"50\" cy=\"50\" r=\"3\" />\n          <circle cx=\"56\" cy=\"50\" r=\"3\" />\n          <circle cx=\"53\" cy=\"55\" r=\"3\" />\n\n          {/* Cashew bottom right */}\n          <path d=\"M 150,145 Q 160,150 152,158 Q 145,152 150,145 Z\" />\n\n          {/* Corn left */}\n          <ellipse cx=\"22\" cy=\"100\" rx=\"4\" ry=\"7\" />\n\n          {/* Pepper right */}\n          <path d=\"M 178,100 C 182,95 180,105 178,100 Z\" />\n\n          {/* Eggplant bottom left */}\n          <path d=\"M 50,150 Q 40,158 48,162 Z\" />\n        </g>\n\n        {/* Inner Stitched Border (Gold) */}\n        <circle cx=\"100\" cy=\"100\" r=\"70\" fill=\"none\" stroke=\"#d4af37\" strokeWidth=\"2\" strokeDasharray=\"4,2\" />\n\n        {/* Inner Fabric Center Circle */}\n        <circle cx=\"100\" cy=\"100\" r=\"68\" fill=\"#fdfdfd\" />\n        <circle cx=\"100\" cy=\"100\" r=\"68\" fill=\"url(#fabricPattern)\" opacity=\"0.6\" />\n        <circle cx=\"100\" cy=\"100\" r=\"68\" fill=\"none\" stroke=\"#1d4d29\" strokeWidth=\"1.5\" />\n\n        {/* Central Logo Text: ERIC MOURA */}\n        {/* ERIC */}\n        <text\n          x=\"100\"\n          y=\"102\"\n          textAnchor=\"middle\"\n          fill=\"#1c4d28\"\n          fontSize=\"36\"\n          fontWeight=\"900\"\n          fontFamily=\"Impact, \'Arial Black\', sans-serif\"\n          letterSpacing=\"3\"\n        >\n          ERIC\n        </text>\n\n        {/* Cross detail inside I/R */}\n        <path d=\"M 104,82 L 104,90 M 100,86 L 108,86\" stroke=\"#c29b38\" strokeWidth=\"1.5\" />\n\n        {/* MOURA */}\n        <text\n          x=\"100\"\n          y=\"126\"\n          textAnchor=\"middle\"\n          fill=\"#1c4d28\"\n          fontSize=\"16\"\n          fontWeight=\"800\"\n          fontFamily=\"\'Arial Black\', Arial, sans-serif\"\n          letterSpacing=\"4\"\n        >\n          MOURA\n        </text>\n      </svg>\n\n      {isEditing && (\n        <label className=\"absolute inset-0 bg-black/60 text-white rounded-full opacity-0 group-hover:opacity-100 flex flex-col items-center justify-center cursor-pointer text-xs font-semibold print:hidden transition-opacity p-2 text-center\">\n          <span>Carregar Imagem</span>\n          <input type=\"file\" accept=\"image/*\" onChange={handleFileChange} className=\"hidden\" />\n        </label>\n      )}\n    </div>\n  );"
      }
      num_matches: 1
    }
  }
}
