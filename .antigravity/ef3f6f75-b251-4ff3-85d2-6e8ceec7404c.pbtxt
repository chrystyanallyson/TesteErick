    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\n\ninterface LogoProps {\n  customLogoUrl?: string;\n  onLogoChange?: (newUrl: string) => void;\n  isEditing?: boolean;\n}\n\nexport const Logo: React.FC<LogoProps> = ({ customLogoUrl, onLogoChange, isEditing }) => {\n  const handleFileChange = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0];\n    if (file && onLogoChange) {\n      const reader = new FileReader();\n      reader.onloadend = () => {\n        onLogoChange(reader.result as string);\n      };\n      reader.readAsDataURL(file);\n    }\n  };\n\n  if (customLogoUrl) {\n    return (\n      <div className=\"relative group flex justify-center items-center\">\n        <img\n          src={customLogoUrl}\n          alt=\"Logo Eric Moura\"\n          className=\"w-28 h-28 object-contain rounded-full border-2 border-emerald-800 print:w-28 print:h-28\"\n        />\n        {isEditing && (\n          <label className=\"absolute inset-0 bg-black/50 text-white rounded-full opacity-0 group-hover:opacity-100 flex items-center justify-center cursor-pointer text-xs font-semibold print:hidden transition-opacity\">\n            <span>Trocar Logo</span>\n            <input type=\"file\" accept=\"image/*\" onChange={handleFileChange} className=\"hidden\" />\n          </label>\n        )}\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"relative group flex justify-center items-center\">\n      {/* SVG recreating the Eric Moura Green Seal Logo */}\n      <svg\n        viewBox=\"0 0 200 200\"\n        className=\"w-28 h-28 print:w-28 print:h-28 drop-shadow-sm select-none\"\n      >\n        {/* Outer dotted/textured ring */}\n        <circle cx=\"100\" cy=\"100\" r=\"96\" fill=\"#1b4d2e\" />\n        <circle cx=\"100\" cy=\"100\" r=\"91\" fill=\"none\" stroke=\"#2d6a4f\" strokeWidth=\"2\" strokeDasharray=\"4,3\" />\n        \n        {/* Middle Ring */}\n        <circle cx=\"100\" cy=\"100\" r=\"85\" fill=\"#2d6a4f\" />\n        <circle cx=\"100\" cy=\"100\" r=\"80\" fill=\"#f4f9f4\" stroke=\"#1b4d2e\" strokeWidth=\"3\" />\n\n        {/* Leaf details top and side */}\n        <path d=\"M 60,65 Q 80,45 100,55 Q 80,75 60,65 Z\" fill=\"#2d6a4f\" opacity=\"0.4\" />\n        <path d=\"M 140,65 Q 120,45 100,55 Q 120,75 140,65 Z\" fill=\"#2d6a4f\" opacity=\"0.4\" />\n\n        {/* Vegetables/Leaves subtle background watermark */}\n        <circle cx=\"70\" cy=\"140\" r=\"8\" fill=\"#1b4d2e\" opacity=\"0.2\" />\n        <circle cx=\"130\" cy=\"140\" r=\"8\" fill=\"#1b4d2e\" opacity=\"0.2\" />\n        <circle cx=\"100\" cy=\"148\" r=\"10\" fill=\"#2d6a4f\" opacity=\"0.2\" />\n\n        {/* Center Banner / Text Container */}\n        <rect x=\"35\" y=\"70\" width=\"130\" height=\"60\" rx=\"6\" fill=\"#386641\" />\n        <rect x=\"38\" y=\"73\" width=\"124\" height=\"54\" rx=\"4\" fill=\"none\" stroke=\"#e9f5ec\" strokeWidth=\"1.5\" />\n\n        {/* Brand Text */}\n        <text\n          x=\"100\"\n          y=\"98\"\n          textAnchor=\"middle\"\n          fill=\"#ffffff\"\n          fontSize=\"24\"\n          fontWeight=\"900\"\n          fontFamily=\"Impact, Arial Black, sans-serif\"\n          letterSpacing=\"2\"\n        >\n          ERIC\n        </text>\n        <text\n          x=\"100\"\n          y=\"118\"\n          textAnchor=\"middle\"\n          fill=\"#d8f3dc\"\n          fontSize=\"13\"\n          fontWeight=\"700\"\n          fontFamily=\"Arial, sans-serif\"\n          letterSpacing=\"3\"\n        >\n          MOURA\n        </text>\n      </svg>\n\n      {isEditing && (\n        <label className=\"absolute inset-0 bg-black/60 text-white rounded-full opacity-0 group-hover:opacity-100 flex flex-col items-center justify-center cursor-pointer text-xs font-semibold print:hidden transition-opacity p-2 text-center\">\n          <span>Carregar Imagem</span>\n          <input type=\"file\" accept=\"image/*\" onChange={handleFileChange} className=\"hidden\" />\n        </label>\n      )}\n    </div>\n  );\n};\n"
    }
