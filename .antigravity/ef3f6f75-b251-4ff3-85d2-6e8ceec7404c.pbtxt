  file_change {
    absolute_path_uri: "file:///src/components/Logo.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "      {/* SVG recreating the exact Eric Moura Green Embroidered Seal Logo */}\n      <svg\n        viewBox=\"0 0 200 200\"\n        className=\"w-28 h-28 print:w-28 print:h-28 drop-shadow-md select-none\"\n      >\n        <defs>\n          {/* Subtle fabric texture for inner circle */}\n          <pattern id=\"fabricPattern\" width=\"6\" height=\"6\" patternUnits=\"userSpaceOnUse\">\n            <path d=\"M0 3 L6 3 M3 0 L3 6\" stroke=\"#e2e8f0\" strokeWidth=\"0.8\" />\n          </pattern>\n          {/* Outer Ring Gradient */}\n          <radialGradient id=\"ringGrad\" cx=\"50%\" cy=\"50%\" r=\"50%\">\n            <stop offset=\"70%\" stopColor=\"#22532d\" />\n            <stop offset=\"100%\" stopColor=\"#15381e\" />\n          </radialGradient>\n        </defs>\n\n        {/* Outer Shadow/Border */}\n        <circle cx=\"100\" cy=\"100\" r=\"98\" fill=\"#14331b\" />\n\n        {/* Outer Green Ring */}\n        <circle cx=\"100\" cy=\"100\" r=\"95\" fill=\"url(#ringGrad)\" stroke=\"#c29b38\" strokeWidth=\"2.5\" strokeDasharray=\"6,2\" />\n\n        {/* Produce Icons around the green ring (golden outline icons) */}\n        {/* Pineapple top right */}\n        <g stroke=\"#d4af37\" strokeWidth=\"1.2\" fill=\"none\" opacity=\"0.85\">\n          {/* Pineapple */}\n          <path d=\"M 148,45 C 150,40 155,42 153,48 C 150,52 145,50 148,45 Z\" />\n          <ellipse cx=\"150\" cy=\"53\" rx=\"5\" ry=\"6\" />\n          \n          {/* Tomato bottom */}\n          <circle cx=\"100\" cy=\"180\" r=\"6\" />\n          <path d=\"M 97,174 Q 100,172 103,174\" />\n\n          {/* Grapes top left */}\n          <circle cx=\"50\" cy=\"50\" r=\"3\" />\n          <circle cx=\"56\" cy=\"50\" r=\"3\" />\n          <circle cx=\"53\" cy=\"55\" r=\"3\" />\n\n          {/* Cashew bottom right */}\n          <path d=\"M 150,145 Q 160,150 152,158 Q 145,152 150,145 Z\" />\n\n          {/* Corn left */}\n          <ellipse cx=\"22\" cy=\"100\" rx=\"4\" ry=\"7\" />\n\n          {/* Pepper right */}\n          <path d=\"M 178,100 C 182,95 180,105 178,100 Z\" />\n\n          {/* Eggplant bottom left */}\n          <path d=\"M 50,150 Q 40,158 48,162 Z\" />\n        </g>\n\n        {/* Inner Stitched Border (Gold) */}\n        <circle cx=\"100\" cy=\"100\" r=\"70\" fill=\"none\" stroke=\"#d4af37\" strokeWidth=\"2\" strokeDasharray=\"4,2\" />\n\n        {/* Inner Fabric Center Circle */}\n        <circle cx=\"100\" cy=\"100\" r=\"68\" fill=\"#fdfdfd\" />\n        <circle cx=\"100\" cy=\"100\" r=\"68\" fill=\"url(#fabricPattern)\" opacity=\"0.6\" />\n        <circle cx=\"100\" cy=\"100\" r=\"68\" fill=\"none\" stroke=\"#1d4d29\" strokeWidth=\"1.5\" />\n\n        {/* Central Logo Text: ERIC MOURA */}\n        {/* ERIC */}\n        <text\n          x=\"100\"\n          y=\"102\"\n          textAnchor=\"middle\"\n          fill=\"#1c4d28\"\n          fontSize=\"36\"\n          fontWeight=\"900\"\n          fontFamily=\"Impact, \'Arial Black\', sans-serif\"\n          letterSpacing=\"3\"\n        >\n          ERIC\n        </text>\n\n        {/* Cross detail inside I/R */}\n        <path d=\"M 104,82 L 104,90 M 100,86 L 108,86\" stroke=\"#c29b38\" strokeWidth=\"1.5\" />\n\n        {/* MOURA */}\n        <text\n          x=\"100\"\n          y=\"126\"\n          textAnchor=\"middle\"\n          fill=\"#1c4d28\"\n          fontSize=\"16\"\n          fontWeight=\"800\"\n          fontFamily=\"\'Arial Black\', Arial, sans-serif\"\n          letterSpacing=\"4\"\n        >\n          MOURA\n        </text>\n      </svg>"
      replacement_content: "      {/* SVG recreating the exact Eric Moura Green Embroidered Patch Seal */}\n      <svg\n        viewBox=\"0 0 200 200\"\n        className=\"w-28 h-28 print:w-28 print:h-28 drop-shadow-md select-none\"\n      >\n        <defs>\n          {/* Canvas Fabric Weave Texture */}\n          <pattern id=\"canvasWeave\" width=\"4\" height=\"4\" patternUnits=\"userSpaceOnUse\">\n            <rect width=\"4\" height=\"4\" fill=\"#e8e5d8\" />\n            <path d=\"M 0,2 L 4,2 M 2,0 L 2,4\" stroke=\"#d5d0bf\" strokeWidth=\"0.8\" />\n          </pattern>\n\n          {/* Green Ring Embroidery Thread Texture */}\n          <pattern id=\"threadPattern\" width=\"4\" height=\"8\" patternUnits=\"userSpaceOnUse\" patternTransform=\"rotate(25)\">\n            <rect width=\"4\" height=\"8\" fill=\"#31633a\" />\n            <line x1=\"0\" y1=\"0\" x2=\"4\" y2=\"8\" stroke=\"#254d2d\" strokeWidth=\"1.2\" />\n          </pattern>\n\n          {/* Rope Border Pattern */}\n          <pattern id=\"ropePattern\" width=\"8\" height=\"8\" patternUnits=\"userSpaceOnUse\" patternTransform=\"rotate(45)\">\n            <rect width=\"8\" height=\"8\" fill=\"#2d5234\" />\n            <line x1=\"0\" y1=\"0\" x2=\"8\" y2=\"8\" stroke=\"#4a7c53\" strokeWidth=\"2.5\" />\n          </pattern>\n\n          {/* Soft inner shadow filter for 3D patch depth */}\n          <filter id=\"patchShadow\" x=\"-10%\" y=\"-10%\" width=\"120%\" height=\"120%\">\n            <feDropShadow dx=\"0\" dy=\"2\" stdDeviation=\"2\" floodOpacity=\"0.3\" />\n          </filter>\n        </defs>\n\n        {/* Outer Stitched Edge / Rope Ring */}\n        <circle cx=\"100\" cy=\"100\" r=\"98\" fill=\"#1b3620\" />\n        <circle cx=\"100\" cy=\"100\" r=\"95\" fill=\"url(#ropePattern)\" stroke=\"#1c3821\" strokeWidth=\"1.5\" />\n\n        {/* Green Embroidered Outer Band */}\n        <circle cx=\"100\" cy=\"100\" r=\"90\" fill=\"url(#threadPattern)\" stroke=\"#224828\" strokeWidth=\"1\" />\n\n        